# Optional build-time checkout links (https only). Leave blank for a local-only build.
# Settings → Advanced can also store these on-device.
VITE_CHECKOUT_MONTHLY_URL=
VITE_CHECKOUT_ANNUAL_URL=
VITE_CHECKOUT_LIFETIME_URL=

# Optional contact shown in Settings and legal pages.
VITE_SUPPORT_EMAIL=

# Optional public origin used in sitemap / share metadata.
VITE_SITE_ORIGIN=
